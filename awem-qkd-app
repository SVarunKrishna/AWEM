# Noise model (same as your code)
def make_noise_model(single_p=0.005, two_p=0.01):
    noise_model = NoiseModel()
    single_qubit_error = depolarizing_error(single_p, 1)
    two_qubit_error = depolarizing_error(two_p, 2)
    noise_model.add_all_qubit_quantum_error(single_qubit_error, ['h', 'x'])
    noise_model.add_all_qubit_quantum_error(two_qubit_error, ['cx'])
    return noise_model
# Utilities
def generate_random_bits(n): return [random.randint(0, 1) for _ in range(n)]
def generate_random_bases(n): return [random.choice(['Z', 'X']) for _ in range(n)]
def mark_decoys(bits, p=0.1): return [random.random() < p for _ in bits]
def apply_qah(qc, bits, bases, num_bits):
    for i in range(num_bits):
        if bits[i] == 1: qc.x(i)
        if bases[i] == 'X': qc.h(i)
def apply_qcel(qc, num_bits):
    for i in range(1, num_bits):
        qc.cx(0, i)
def insert_eavesdropper(qc, eve_bases, num_bits):
    for i in range(num_bits):
        if eve_bases[i] == 'X': qc.h(i)
        qc.measure(i, i)
        qc.reset(i)
        if eve_bases[i] == 'X': qc.h(i)
def apply_measurement(qc, bases, num_bits):
    for i in range(num_bits):
        if bases[i] == 'X': qc.h(i)
        qc.measure(i, i)
def awem_filter(alice, bob):
    return [a for a, b in zip(alice, bob) if a == b]
def logic_gate_filter(alice, bob):
    return ([a ^ b for a, b in zip(alice, bob)],
            [a & b for a, b in zip(alice, bob)],
            [a | b for a, b in zip(alice, bob)])
def sha256_amplify(key):
    digest = hashlib.sha256(''.join(map(str, key)).encode()).hexdigest()
    return [int(b) for b in bin(int(digest, 16))[2:].zfill(256)]
def qber(alice, bob):
    return (sum(a != b for a, b in zip(alice, bob)) / len(alice)) if alice else 1.0
def shannon_entropy(bits):
    if len(bits) == 0:
        return 0.0
    p = [bits.count(x)/len(bits) for x in set(bits)]
    return entropy(p, base=2)
# Cascade: realistic simulated Cascade-style error correction
def _parity(bits: List[int], indices: List[int]) -> int:
    p = 0
    for i in indices:
        p ^= bits[i]
    return p
def _bisect_fix(alice: List[int], bob: List[int], indices: List[int]) -> int:
    lo = 0
    hi = len(indices) - 1
    while lo < hi:
        mid = (lo + hi) // 2
        left_idx = indices[lo:mid+1]
        pa = _parity(alice, left_idx)
        pb = _parity(bob, left_idx)
        if pa != pb:
            hi = mid
        else:
            lo = mid + 1
    flip_pos = indices[lo]
    bob[flip_pos] ^= 1
    return flip_pos
def cascade_correct(alice: List[int], bob: List[int],
                    max_passes: int = 4,
                    initial_block_size: int | None = None,
                    seed: int | None = None
                    ) -> Tuple[List[int], Dict]:
    """
    Simulated Cascade-style error correction.
    Returns (corrected_bob, stats)
    stats: corrections, positions, passes, final_qber
    """
    if len(alice) != len(bob):
        raise ValueError("Alice and Bob bit lists must have the same length for Cascade.")
    n = len(alice)
    if n == 0:
        return bob[:], {"corrections": 0, "positions": [], "passes": 0, "final_qber": 0.0}
    rng = random.Random(seed)
    corrected_bob = bob[:]  # copy
    total_corrections = 0
    correction_positions = []
    if initial_block_size is None:
        initial_block_size = max(1, n // (2 ** (max_passes - 1))) if max_passes > 1 else max(1, n // 2)
    for p in range(max_passes):
        # random permutation for this pass
        perm = list(range(n))
        rng.shuffle(perm)
        block_size = initial_block_size * (2 ** p)
        block_size = max(1, min(block_size, n))
        blocks = [perm[i:i + block_size] for i in range(0, n, block_size)]

        i = 0
        while i < len(blocks):
            indices = blocks[i]
            if _parity(alice, indices) != _parity(corrected_bob, indices):
                fixed_pos = _bisect_fix(alice, corrected_bob, indices)
                total_corrections += 1
                correction_positions.append(fixed_pos)
                # recheck previous block to simulate interactivity
                i = max(0, i - 1)
            else:
                i += 1

    mismatches = sum(a != b for a, b in zip(alice, corrected_bob))
    final_qber = mismatches / n if n else 0.0
    stats = {
        "corrections": total_corrections,
        "positions": correction_positions,
        "passes": max_passes,
        "final_qber": final_qber
    }
    return corrected_bob, stats

# CHSH (same as your code)
def chsh_measure_circuit(angle_a, angle_b):
    qc = QuantumCircuit(2, 2)
    qc.h(0); qc.cx(0, 1)
    qc.ry(2*angle_a, 0)
    qc.ry(2*angle_b, 1)
    qc.measure([0, 1], [0, 1])
    return qc

def chsh_test_on_circuit(noise_model):
    sim = AerSimulator(noise_model=noise_model)
    shots = 2048
    angles = {
        'A0': 0,
        'A1': np.pi/4,
        'B0': np.pi/8,
        'B1': -np.pi/8
    }
    def get_corr(angle_a, angle_b):
        qc = chsh_measure_circuit(angle_a, angle_b)
        result = sim.run(transpile(qc, sim), shots=shots).result()
        counts = result.get_counts()
        total = sum(counts.values())
        same = counts.get('00', 0) + counts.get('11', 0)
        diff = counts.get('01', 0) + counts.get('10', 0)
        return (same - diff) / total if total else 0.0

    E = {
        'A0B0': get_corr(angles['A0'], angles['B0']),
        'A0B1': get_corr(angles['A0'], angles['B1']),
        'A1B0': get_corr(angles['A1'], angles['B0']),
        'A1B1': get_corr(angles['A1'], angles['B1']),
    }
    S = abs(E['A0B0'] + E['A0B1'] + E['A1B0'] - E['A1B1'])
    return round(S, 4)
# Core simulation (adapted to be parametric)
def run_one_awem_qkd_sim(run_id, num_bits, enable_eve, max_retries, noise_model):
    retry = 0
    while retry < max_retries:
        alice_bits = generate_random_bits(num_bits)
        alice_bases = generate_random_bases(num_bits)
        bob_bases   = generate_random_bases(num_bits)
        eve_bases   = generate_random_bases(num_bits) if enable_eve else []
        decoys      = mark_decoys(alice_bits)

        qc = QuantumCircuit(num_bits, num_bits)
        apply_qah(qc, alice_bits, alice_bases, num_bits)
        apply_qcel(qc, num_bits)
        if enable_eve:
            insert_eavesdropper(qc, eve_bases, num_bits)
        apply_measurement(qc, bob_bases, num_bits)

        sim = AerSimulator(noise_model=noise_model)
        result = sim.run(transpile(qc, sim), shots=1, memory=True).result()
        bob_bits = [int(x) for x in result.get_memory()[0][::-1]]

        # sift by basis match and not decoy
        sifted_alice = [alice_bits[i] for i in range(num_bits) if alice_bases[i] == bob_bases[i] and not decoys[i]]
        sifted_bob   = [bob_bits[i]   for i in range(num_bits) if alice_bases[i] == bob_bases[i] and not decoys[i]]

        xor_g, and_g, or_g = logic_gate_filter(sifted_alice, sifted_bob)

        # Use the realistic Cascade implementation
        corrected, cascade_stats = cascade_correct(sifted_alice, sifted_bob, max_passes=4, seed=None)

        mitigated  = awem_filter(sifted_alice, corrected)
        final_key  = sha256_amplify(mitigated)

        # Use corrected bits to compute metrics. final_qber from cascade_stats is available.
        err   = cascade_stats.get("final_qber", qber(sifted_alice, corrected))
        ent   = shannon_entropy(corrected)
        s_val = chsh_test_on_circuit(noise_model)
        passed = (err < 0.25) and (ent > 0.85) and (s_val > 2.0)

        # Prepare a concise record for UI
        record = {
            "run_id": run_id,
            "retry_used": retry + 1,
            "qber": err,
            "entropy": ent,
            "s_value": s_val,
            "privacy_passed": bool(passed),
            "secure_key_len": len(final_key),
            "alice_sifted": sifted_alice[:64],  # short preview
            "bob_sifted": corrected[:64],       # short preview
            "xor": xor_g[:32],
            "and": and_g[:32],
            "or":  or_g[:32],
            "mitigated": mitigated[:64],
            "final_key_preview": final_key[:64],
            # Cascade stats
            "corrections_count": cascade_stats.get("corrections", 0),
            "corrections_positions": cascade_stats.get("positions", [])[:128],
            "cascade_passes": cascade_stats.get("passes", 0),
        }

        if passed or retry == max_retries - 1:
            return record
        retry += 1

def run_all_sims(num_sims, num_bits, enable_eve, max_retries, single_p, two_p):
    noise_model = make_noise_model(single_p=single_p, two_p=two_p)
    records = []
    for i in range(1, num_sims + 1):
        rec = run_one_awem_qkd_sim(i, num_bits, enable_eve, max_retries, noise_model)
        records.append(rec)
        # also write per-run JSON for traceability
        per_run_path = os.path.join(OUTPUT_DIR, f"awem_results_run_{i}.json")
        with open(per_run_path, "w") as jf:
            json.dump(rec, jf, indent=4)
    return records
# Visualization helpers
def make_summary_df(records):
    if not records:
        return pd.DataFrame()
    df = pd.DataFrame([{
        "Run": r["run_id"],
        "RetriesUsed": r["retry_used"],
        "QBER": r["qber"],
        "Entropy": r["entropy"],
        "S_value": r["s_value"],
        "PrivacyPassed": r["privacy_passed"],
        "SecureKeyLen": r["secure_key_len"]
    } for r in records])
    return df

def fig_metrics(df):
    if df.empty:
        return go.Figure()
    fig = make_subplots(rows=3, cols=1, shared_xaxes=True,
                        subplot_titles=("QBER per Run", "Entropy per Run", "CHSH S-value per Run"))
    fig.add_trace(go.Scatter(x=df["Run"], y=df["QBER"], mode="lines+markers", name="QBER"), row=1, col=1)
    fig.add_trace(go.Scatter(x=df["Run"], y=df["Entropy"], mode="lines+markers", name="Entropy"), row=2, col=1)
    fig.add_trace(go.Scatter(x=df["Run"], y=df["S_value"], mode="lines+markers", name="S-value"), row=3, col=1)

    # add thresholds
    fig.add_hline(y=0.25, line_dash="dot", line_color="red", row=1, col=1)
    fig.add_hline(y=0.85, line_dash="dot", line_color="orange", row=2, col=1)
    fig.add_hline(y=2.0,  line_dash="dot", line_color="green", row=3, col=1)

    fig.update_layout(height=800, margin=dict(l=50, r=30, t=60, b=40), legend=dict(orientation="h"))
    return fig

def fig_privacy_pie(df):
    if df.empty:
        return go.Figure()
    counts = df["PrivacyPassed"].value_counts()
    labels = ["Passed", "Failed"]
    values = [int(counts.get(True, 0)), int(counts.get(False, 0))]
    fig = go.Figure(go.Pie(labels=labels, values=values, hole=0.4))
    fig.update_layout(title_text="Privacy Check Outcome")
    return fig

def save_pngs(figs_with_names):
    if not KALEIDO_OK:
        return "PNG export skipped (install 'kaleido' to enable)."
    messages = []
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    for name, fig in figs_with_names:
        path = os.path.join(CHART_DIR, f"{name}_{ts}.png")
        try:
            fig.write_image(path, scale=2, width=1200, height=800)
            messages.append(f"Saved: {path}")
        except Exception as e:
            messages.append(f"Failed to save {name}: {e}")
    return "\n".join(messages) if messages else "No figures to save."
