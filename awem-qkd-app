@app.callback(
    Output("records_store", "data"),
    Output("run_msg", "children"),
    Input("run_btn", "n_clicks"),
    State("bits", "value"),
    State("runs", "value"),
    State("retries", "value"),
    State("eve", "value"),
    State("noise1q", "value"),
    State("noise2q", "value"),
    prevent_initial_call=True
)
def on_run(n, num_bits, runs, retries, eve, n1q, n2q):
    ctx = callback_context
    if not ctx.triggered:
        raise Exception("No trigger")
    msg = f"Running {runs} simulation(s) with NUM_BITS={num_bits}, Eve={'ON' if eve else 'OFF'}, noise1q={n1q}, noise2q={n2q}…"
    records = run_all_sims(
        num_sims=runs,
        num_bits=num_bits,
        enable_eve=eve,
        max_retries=retries,
        single_p=float(n1q),
        two_p=float(n2q),
    )
    # Also save consolidated CSV/JSON
    df = make_summary_df(records)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    csv_path = os.path.join(OUTPUT_DIR, f"awem_summary_{ts}.csv")
    json_path = os.path.join(OUTPUT_DIR, f"awem_summary_{ts}.json")
    try:
        df.to_csv(csv_path, index=False)
    except Exception:
        pass
    with open(json_path, "w") as jf:
        json.dump(records, jf, indent=4)
    msg += f" Saved summary to:\n- {csv_path}\n- {json_path}\n(Outputs saved under: {OUTPUT_DIR})"
    return records, msg

