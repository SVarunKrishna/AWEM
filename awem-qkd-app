    for f in (fig_qber, fig_entropy, fig_s):
        f.update_layout(margin=dict(l=10, r=10, t=40, b=10), height=260)
    return fig_qber, fig_entropy, fig_s
# New: Transmission animation callback (complete)
@app.callback(
    Output("transmission_anim", "figure"),
    Input("records_store", "data")
)
def animate_transmission(records):
    if not records:
        fig_empty = go.Figure()
        fig_empty.update_layout(
            title="Quantum Transmission (Alice → Eve → Bob)",
            xaxis=dict(range=[-0.1, 1.1], showticklabels=False),
            yaxis=dict(range=[-1, 1], showticklabels=False),
            annotations=[{"text": "Run a simulation to see the animation",
                          "x": 0.5, "y": 0, "showarrow": False}]
        )
        return fig_empty

    bits = records[0].get("alice_sifted", [])[:12]
    num_bits = len(bits)
    if num_bits == 0:
        fig_no_bits = go.Figure()
        fig_no_bits.update_layout(
            title="Quantum Transmission (Alice → Eve → Bob)",
            xaxis=dict(range=[-0.1, 1.1], showticklabels=False),
            yaxis=dict(range=[-1, 1], showticklabels=False),
            annotations=[{"text": "No sifted bits in this run to animate",
                          "x": 0.5, "y": 0, "showarrow": False}]
        )
        return fig_no_bits

    frames = []
    x_positions = [0, 0.5, 1.0]  # Alice, Eve, Bob
    for i, bit in enumerate(bits):
        color = "royalblue" if bit == 0 else "orange"
        frames.append(go.Frame(
            name=f"bit{i}_a",
            data=[go.Scatter(x=[x_positions[0]], y=[0],
                             mode="markers+text",
                             text=[str(bit)], textposition="top center",
                             marker=dict(size=18, color=color,
                                         line=dict(width=2, color="black")))]
        ))
        frames.append(go.Frame(
            name=f"bit{i}_e",
            data=[go.Scatter(x=[x_positions[1]], y=[0],
                             mode="markers+text",
                             text=[str(bit)], textposition="top center",
                             marker=dict(size=22, color=color,
                                         line=dict(width=3, color="black")))]
        ))
        frames.append(go.Frame(
            name=f"bit{i}_b",
            data=[go.Scatter(x=[x_positions[2]], y=[0],
                             mode="markers+text",
                             text=[str(bit)], textposition="top center",
                             marker=dict(size=18, color=color,
                                         line=dict(width=2, color="black")))]
        ))

    fig = go.Figure(
        data=[go.Scatter(x=[], y=[], mode="markers")],
        frames=frames,
        layout=go.Layout(
            title="Quantum Transmission (Alice → Eve → Bob)",
            xaxis=dict(range=[-0.1, 1.1], showticklabels=False),
            yaxis=dict(range=[-1, 1], showticklabels=False),
            showlegend=False,
            annotations=[
                {"text": "Alice", "x": 0, "y": -0.5, "showarrow": False},
                {"text": "Eve", "x": 0.5, "y": -0.5, "showarrow": False},
                {"text": "Bob", "x": 1.0, "y": -0.5, "showarrow": False}
            ],
            updatemenus=[{
                "type": "buttons",
                "buttons": [
                    {"label": "▶ Play", "method": "animate",
                     "args": [None,
                              {"frame": {"duration": 600, "redraw": True},
                               "fromcurrent": True, "mode": "immediate"}]},
                    {"label": "⏸ Pause", "method": "animate",
                     "args": [[None],
                              {"frame": {"duration": 0, "redraw": False},
                               "mode": "immediate"}]}
                ],
                "x": 0.5, "y": -0.3, "xanchor": "center"
            }]
        )
    )
    return fig
